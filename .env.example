# ============================================================
# LLM 提供商配置（支持多提供商切换）
# ============================================================

# ---- 快速切换 DeepSeek（复制下面 4 行到 .env.local，填入密钥即可）----
# LLM_PROVIDER=openai-compatible
# OPENAI_API_KEY=sk-你的DeepSeek密钥
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# LLM_PROVIDER: gemini（默认）| openai-compatible
# - gemini: 使用 Google Gemini API（默认）
# - openai-compatible: 使用任何 OpenAI 兼容端点
#   （OpenAI / DeepSeek / Moonshot(Kimi) / OpenRouter / 本地 vLLM、Ollama 等）
LLM_PROVIDER=gemini

# ---- Gemini（LLM_PROVIDER=gemini）----
# GEMINI_API_KEY: 必填。AI Studio 会在运行时从用户 secrets 自动注入；
# 本地运行请填入你的 Gemini API Key。
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODELS: 可选。逗号分隔的模型列表，按顺序回退。
# 默认：gemini-3.5-flash,gemini-flash-latest,gemini-2.5-flash,gemini-3.1-pro-preview,gemini-2.5-pro
# GEMINI_MODELS="gemini-2.5-flash,gemini-2.5-pro"

# ---- OpenAI 兼容提供商（LLM_PROVIDER=openai-compatible）----
# OPENAI_API_KEY: 必填。
# OPENAI_API_KEY="MY_OPENAI_API_KEY"

# OPENAI_BASE_URL: 端点地址，末尾不需要斜杠。
# 常见示例：
#   OpenAI:        https://api.openai.com/v1
#   DeepSeek:      https://api.deepseek.com/v1
#   Moonshot/Kimi: https://api.moonshot.cn/v1
#   OpenRouter:    https://openrouter.ai/api/v1
#   本地 Ollama:   http://localhost:11434/v1
#   本地 vLLM:     http://localhost:8000/v1
# 默认：https://api.openai.com/v1
# OPENAI_BASE_URL="https://api.deepseek.com/v1"

# OPENAI_MODEL: 使用哪个模型。
# 示例：deepseek-chat / deepseek-reasoner / gpt-4o / gpt-4o-mini / kimi-k2 /
#       ollama 的模型名（如 qwen2.5:14b）
# 默认：gpt-4o-mini
# OPENAI_MODEL="deepseek-chat"

# OPENAI_MAX_TOKENS: 可选。openai-compatible 请求的 max_tokens 上限。
#   不同端点上限不同，超限会被 400 拒绝：
#     DeepSeek deepseek-chat：8192（默认即 8192）
#     OpenAI gpt-4o：16384；gpt-4o-mini：16384
#   默认：8192
# OPENAI_MAX_TOKENS=8192

# ============================================================
# 其他配置
# ============================================================

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Logging: debug|info|warn|error (default: debug in dev, info in prod)
LOG_LEVEL=debug
# Write logs to ./logs/ directory (optional)
# LOG_TO_FILE=true
